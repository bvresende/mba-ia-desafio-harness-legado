{
  "ignoreWorkspaces": ["."],
  "workspaces": {
    "api": {
      "entry": [
        "src/main.ts",
        "src/jobs/triage-worker.ts",
        "prisma/seed.ts",
        "src/**/*.test.ts",
        "test/integration/**/*.test.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "web": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
